# Docker Desktop example. Addresses and model filenames must match your local providers.
STH_HOST_PORT=9322
STH_IMAGE=sth-local:authoring
STH_GENERATION_PROVIDERS_JSON='{"magpie":{"baseUrl":"http://host.docker.internal:3425/v1"}}'
STH_COMFY_URL=http://host.docker.internal:8191
STH_COMFY_WORKFLOW=/app/examples/comfyui/anima-turbo.json
STH_COMFY_PROMPT_NODE=4
STH_COMFY_OUTPUT_NODE=9
